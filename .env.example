# Copy the settings you need into your existing .env; keep secrets local.
REFMATCH_PROVIDER=google
GEMINI_API_KEY=
REFMATCH_MODEL=google:gemini-3.5-flash-lite
REFMATCH_PORT=4173
# Google setup and permission troubleshooting: docs/google-gemini-setup.md.

# Optional Copilot Studio adapter: set REFMATCH_PROVIDER=copilot-studio.
# Copilot Studio > Channels > Mobile app > Token Endpoint.
COPILOT_STUDIO_TOKEN_ENDPOINT=
# For a secured Direct Line channel, use this secret instead of the token endpoint.
# This is a channel credential, not an end-user sign-in token.
COPILOT_STUDIO_DIRECT_LINE_SECRET=
# Override only if your agent uses a regional Direct Line endpoint.
COPILOT_STUDIO_DIRECT_LINE_URL=https://directline.botframework.com/v3/directline
# Agent instructions and sign-in limitations: docs/microsoft-copilot-setup.md.

# Optional OpenAI adapter: explicitly set REFMATCH_PROVIDER=openai to enable it.
# Server-side only. Never put credentials in browser code.
OPENAI_API_KEY=
# For OpenAI, also change REFMATCH_MODEL to openai:gpt-4.1-mini.

# Evaluation Lab: set exact model IDs alongside the relevant server-only key.
REFMATCH_EVAL_OPENAI_MODEL=
REFMATCH_EVAL_ANTHROPIC_MODEL=
REFMATCH_EVAL_GOOGLE_MODEL=
ANTHROPIC_API_KEY=
