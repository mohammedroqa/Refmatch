{
  "name": "refmatch",
  "version": "2.0.0",
  "private": true,
  "description": "Premier League matchweek referee planning with three years of evidence",
  "type": "module",
  "scripts": {
    "build": "node scripts/build-app.mjs",
    "build:static": "node scripts/build-static.mjs",
    "prepreview": "npm run build",
    "preview": "node scripts/preview.mjs",
    "start": "npm run preview",
    "test:e2e": "node scripts/test-e2e.mjs",
    "test:weekly": "node scripts/test-weekly-e2e.mjs",
    "test:responsive": "node scripts/test-responsive.mjs",
    "test": "node --test demo/*.test.js scripts/*.test.mjs",
    "data:refresh": "python3 scripts/refresh-data.py",
    "data:weekly": "python3 scripts/refresh-weekly.py",
    "render": "node scripts/render.mjs",
    "render:stills": "node scripts/render.mjs --stills",
    "assets": ".venv/bin/python scripts/build-brand.py"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "playwright": "1.64.1"
  },
  "dependencies": {
    "@ag-ui/client": "1.0.2",
    "@copilotkit/core": "1.79.1",
    "@copilotkit/runtime": "1.79.1",
    "rxjs": "7.8.1",
    "zod": "4.6.6"
  },
  "overrides": {
    "zod": "$zod",
    "undici": "6.29.1"
  }
}
